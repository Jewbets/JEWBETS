* {
  box-sizing: border-box;
  margin: 0;
  font-family: Helvetica, Arial, sans-serif;
}

body {
  background: #fff;
  color: #111;
}

/* HEADER */
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid #ddd;
}

.logo {
  font-size: 24px;
  letter-spacing: 3px;
}

nav a {
  margin-left: 20px;
  text-decoration: none;
  color: #111;
  font-weight: bold;
}

/* HERO */
.hero {
  text-align: center;
  padding: 120px 20px;
  background: #000;
  color: #fff;
}

.hero h2 {
  font-size: 42px;
  letter-spacing: 2px;
}

.hero p {
  margin: 15px 0;
}

.button {
  display: inline-block;
  background: #fff;
  color: #000;
  padding: 12px 25px;
  text-decoration: none;
  margin-top: 20px;
  font-weight: bold;
}

/* SECTIONS */
section {
  padding: 80px 20px;
  max-width: 1200px;
  margin: auto;
}

h2 {
  margin-bottom: 40px;
  text-align: center;
  letter-spacing: 2px;
}

/* PRODUCTS */
.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 30px;
}

.product {
  text-align: center;
}

.img-placeholder {
  background: #eaeaea;
  height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

/* ABOUT */
#about p {
  max-width: 700px;
  margin: auto;
  text-align: center;
  line-height: 1.8;
}

/* CONTACT */
#contact p {
  text-align: center;
  margin-bottom: 10px;
}

/* FOOTER */
footer {
  text-align: center;
  padding: 20px;
  border-top: 1px solid #ddd;
  font-size: 14px;
}

.coming-soon {
  text-align: center;
  margin-top: 40px;
  font-style: italic;
}
